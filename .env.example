APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=18000
POSTGRES_DB=upivo_demo
POSTGRES_USER=upivo_demo
# Пароль задайте сами: openssl rand -hex 32 (шестнадцатеричное значение пригодно для URL).
POSTGRES_PASSWORD=
POSTGRES_PORT=15432
# Локальный DSN для запуска без Compose: подставьте тот же пароль вместо CHANGE_ME.
# Compose переопределяет DATABASE_URL на сервис postgres:5432 внутри своей сети.
DATABASE_URL=postgresql+psycopg://upivo_demo:CHANGE_ME@localhost:15432/upivo_demo
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=@preset/deep-seek-v4-flash-via-direct-deep-seek-provider
LLM_TIMEOUT_SECONDS=60
# AI operation providers are independent; existing defaults stay unchanged.
IMPORTANCE_PROVIDER=typesafe
RELEVANCE_PROVIDER=typesafe
# For GPT: LLM_PROVIDER=openai and/or IMPORTANCE_PROVIDER/RELEVANCE_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=60
# Optional per-operation overrides; omit to use OPENAI_MODEL.
# OPENAI_SUMMARY_MODEL=gpt-5.4-mini
# OPENAI_IMPORTANCE_MODEL=gpt-5.4-mini
# OPENAI_RELEVANCE_MODEL=gpt-5.4-mini
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-1.14.0
TYPESAFE_TIMEOUT_SECONDS=60
# ITD-84: автоматический общий сбор по расписанию Celery Beat (UTC).
# На демостенде выключен: включайте после настройки ключей и бюджета.
SCHEDULED_PIPELINE_ENABLED=false
SCHEDULED_PIPELINE_INTERVAL_SECONDS=1800
# Необязательный лимит публикаций на источник в scheduled-проходе (не ai_limit и не
# бюджет); без строки — обычное production-поведение. Пустое значение не писать.
# SCHEDULED_PIPELINE_SOURCE_LIMIT=10
# Полный автоматический AI разрешён (жёсткой денежной квоты нет; false — opt-out).
# На демостенде выключен: true только для согласованного автоматического AI.
SCHEDULED_PAID_AI_ENABLED=false
LOG_LEVEL=INFO
# Секрет подписи токена входа: не менее 32 символов, openssl rand -hex 32.
AUTH_TOKEN_SECRET=
